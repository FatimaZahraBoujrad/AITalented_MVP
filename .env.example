# Copy to .env for local (non-docker) development.
# In the Base44 sandbox these are supplied by docker-compose.base44.yml.

DATABASE_URL="postgresql://aitalented:aitalented_dev@localhost:5432/aitalented?schema=public"
APP_URL="http://localhost:3000"

# Seed credentials (admin is created on first boot)
ADMIN_EMAIL="admin@aitalented.dev"
ADMIN_PASSWORD="admin12345"

# Optional: raises GitHub API rate limits for the repo verifier (60 req/h anonymous)
# GITHUB_TOKEN=""

# Optional: Stripe billing. Without these the billing page shows "not configured"
# and recruiters stay on the 14-day trial.
# STRIPE_SECRET_KEY=""
# STRIPE_PRICE_ID=""
# STRIPE_WEBHOOK_SECRET=""

# Ranking weights (Section 7.3). Comma-free decimals.
# RANK_W_VERIFIED_SKILLS=3
# RANK_W_PROJECT_DEPTH=2
# RANK_W_DEPLOYMENT=1.5
# RANK_W_COMPLETENESS=1
# RANK_W_RECENCY=0.5
# RANK_RECENCY_HALF_LIFE_DAYS=60
